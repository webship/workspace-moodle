{
  "name": "@webship.co/workspace-moodle",
  "version": "1.0.0",
  "description": "Moodle for Webship Workspace: the builder (`cmd-moodle-project.sh`, the release package installed by its own command-line installer, with the test course on request) and the CLI tool in every sites folder, the default accounts, the Moodle step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-moodle.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "moodle",
    "label": "Moodle",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-moodle-project.sh",
        "commands/cmd-tools-moodle-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-moodle.sh"
      ],
      "args": [
        "scripts/args/arg-moodle.sh",
        "scripts/args/arg-moodle-cli.sh"
      ],
      "machine": [
        "testing/site.feature",
        "scripts/php/test-site.php"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/moodle-site-builder.md",
        "ai/agents/moodle-tester.md"
      ],
      "skills": [
        "ai/skills/moodle-scenarios"
      ],
      "commands": [
        "ai/commands/moodle-test.md"
      ],
      "prompts": [
        "ai/prompts/moodle-build-and-test.md",
        "ai/prompts/moodle-scenarios-for-a-role.md"
      ]
    },
    "features": [
      "features/moodle.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
